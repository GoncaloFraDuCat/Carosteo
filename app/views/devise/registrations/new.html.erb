<div class="container-card ml-5">
        <h1>Doctors</h1>



<div class="row mt-5">
  <div class="col-md-3 mx-auto">
    <div class="card p-3 ">
    <div class="card-header mb-2 bg-primary text-white text-center">
        <h2>Sign up</h2>
        </div>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

    <%= f.hidden_field :role, value: params[:type] %>
      <div class="field">
        <%= f.label :first_name %><br />
        <%= f.text_field :first_name, autofocus: true, autocomplete: "first_name", class: "form-control mt-1 mb-1" %>
      </div>
      
      <div class="field">
        <%= f.label :last_name %><br />
        <%= f.text_field :last_name, autocomplete: "last_name", class: "form-control mt-1 mb-1" %>
      </div>

      <div class="field">
        <%= f.label :email %><br />
        <%= f.email_field :email, autocomplete: "email", class: "form-control mt-1 mb-1" %>
      </div>

      <div class="field">
        <%= f.label :password %>
        <% if @minimum_password_length %>
        <em>(<%= @minimum_password_length %> characters minimum)</em>
        <% end %><br />
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control mt-1 mb-1" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation %><br />
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control mt-1 mb-1" %>
      </div>

      <div class="actions">
        <%= f.submit "Sign up", class: "btn btn-primary w-100 mt-3 mb-3 " %>
      </div>

      <div>
      <%= link_to "Log in", new_session_path(resource_name), class: "btn btn-success w-100 mt-1 text-decoration-none text-white"  %>
      </div>





<% end %>

<!-- <%= render "devise/shared/links" %> -->
</div>
</div>
</div>
</div>