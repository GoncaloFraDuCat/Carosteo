<h1>Carol-Osteo</h1>

<% if user_signed_in? %>
    <h2>Welcome <%= current_user.first_name + " " + current_user.last_name%>!!</h2>
<% end %>


<% unless current_user %>
<%= link_to "Sign in as doctor", new_user_session_path(type: 'doctor') %> 
<br>
<%= link_to "Sign in as patient", new_user_session_path(type: 'patient') %> 
<br>
<%= link_to "Sign up as doctor", new_user_registration_path(type: 'doctor') %>
<br>
<%= link_to "Sign up as patient", new_user_registration_path(type: 'patient') %>
<% end %>
<br>

<% if user_signed_in? %>

<%= link_to 'Show All Doctors', doctors_path %>

<%= link_to "Log Out", destroy_user_session_path, data: { turbo_method: :delete } %>
<% end %>